{
  "name": "tecnickcom/tc-lib-pdf-font",
  "description": "PHP library containing PDF page formats and definitions",
  "license": "LGPL-3.0-or-later",
  "type": "library",
  "keywords": [
    "tc-lib-pdf-font",
    "PDF",
    "font",
    "TTF",
    "AFM",
    "PFB",
    "import"
  ],
  "authors": [
    {
      "name": "Nicola Asuni",
      "email": "info@tecnick.com",
      "role": "lead"
    }
  ],
  "homepage": "https://tecnick.com/",
  "support": {
    "issues": "https://github.com/tecnickcom/tc-lib-pdf-font/issues",
    "source": "https://github.com/tecnickcom/tc-lib-pdf-font"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/tecnickcom"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pcre": "*",
    "ext-zlib": "*",
    "tecnickcom/tc-lib-file": "dev-byte-bitwise as 3.99.99",
    "tecnickcom/tc-lib-pdf-encrypt": "^2.5",
    "tecnickcom/tc-lib-unicode-data": "^2.3"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "pdepend/pdepend": "3.x-dev",
    "phpcompatibility/php-compatibility": "^10.0.0@dev",
    "phpmd/phpmd": "3.x-dev",
    "phpstan/phpstan": "^2.1.46",
    "phpunit/phpunit": "11.5 || 12.5 || ^13.1",
    "squizlabs/php_codesniffer": "^4.0.1"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/mreiden/tc-lib-file",
      "only": [
        "tecnickcom/tc-lib-file"
      ]
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Com\\Tecnick\\Pdf\\Font\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\": "test"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "analyse": "./vendor/bin/mago --config ./mago.src.toml analyze src && ./vendor/bin/mago --config ./mago.test.toml analyze test",
    "cs-check": "./vendor/bin/mago --config ./mago.src.toml lint src && ./vendor/bin/mago --config ./mago.test.toml lint test",
    "cs-fix": "./vendor/bin/mago fmt src test",
    "test": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --stderr test"
  }
}
